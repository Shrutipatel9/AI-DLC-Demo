{
  "version": "qs-v1",
  "source": "aidlc/spaces/default/knowledge/onboarding_questionnaire_spec.md ([QS]) sections 2-5, status Draft",
  "notes": [
    "[Open — client] [QS] §5: the Q9/Q11 follow-up shape is not confirmed; modelled as Yes/No with an optional free-text follow-up revealed by Yes.",
    "[Open — client] [QS] §3/§5: the Q19 condition is inferred from one recorded pass; modelled as Q4 = Masculine or No Preference.",
    "[Decided by delivery team] Every question is required except Q7 (multi-select with no 'none' option in [QS]) and Q23 ('Anything else'); follow-ups are optional.",
    "[Interpretation of FR-008(f); confirm with the client] Q8-Q12 carry the medical flag; their follow-ups inherit it (AC4.4.3)."
  ],
  "disclaimerText": "I hereby confirm that I do not have any concerns related to Body Dysmorphic Disorder or other conditions affecting my perception of my appearance. I understand that treatment recommendations are purely for informational reasons and not medical guidance. Any implementation of treatments is at my own discretion.",
  "questions": [
    {
      "id": "q1",
      "order": 1,
      "text": "What is your occupation?",
      "type": "text",
      "required": true,
      "placeholder": "e.g. Entrepreneur",
      "maxLength": 500
    },
    {
      "id": "q2",
      "order": 2,
      "text": "How often do you smoke?",
      "type": "single",
      "required": true,
      "options": [
        { "value": "never", "label": "Never" },
        { "value": "rarely", "label": "Rarely" },
        { "value": "sometimes", "label": "Sometimes" },
        { "value": "often", "label": "Often" },
        { "value": "daily", "label": "Daily" }
      ]
    },
    {
      "id": "q3",
      "order": 3,
      "text": "How often do you drink?",
      "type": "single",
      "required": true,
      "options": [
        { "value": "never", "label": "Never" },
        { "value": "rarely", "label": "Rarely" },
        { "value": "sometimes", "label": "Sometimes" },
        { "value": "often", "label": "Often" },
        { "value": "daily", "label": "Daily" }
      ]
    },
    {
      "id": "q4",
      "order": 4,
      "text": "Would you rather look more masculine or more feminine?",
      "type": "single",
      "required": true,
      "options": [
        { "value": "masculine", "label": "Masculine" },
        { "value": "feminine", "label": "Feminine" },
        { "value": "no_preference", "label": "No Preference" }
      ]
    },
    {
      "id": "q5",
      "order": 5,
      "text": "Have you had any non-surgical aesthetic treatments before?",
      "type": "yesno",
      "required": true
    },
    {
      "id": "q6",
      "order": 6,
      "text": "We're strictly non-surgical, but for accuracy, have you ever undergone facial cosmetic surgery?",
      "type": "yesno",
      "required": true
    },
    {
      "id": "q7",
      "order": 7,
      "text": "Please select all treatment types you are comfortable undergoing:",
      "type": "multi",
      "required": false,
      "options": [
        { "value": "botox", "label": "Botox", "group": "Injectables (minimally invasive)" },
        {
          "value": "dermal_fillers",
          "label": "Dermal Fillers",
          "group": "Injectables (minimally invasive)"
        },
        {
          "value": "fat_dissolving_injections",
          "label": "Fat-Dissolving Injections",
          "group": "Injectables (minimally invasive)"
        },
        { "value": "laser", "label": "Laser", "group": "Non-invasive treatments" },
        { "value": "ipl_led", "label": "IPL/LED", "group": "Non-invasive treatments" },
        { "value": "ultrasound", "label": "Ultrasound", "group": "Non-invasive treatments" },
        {
          "value": "radiofrequency",
          "label": "Radiofrequency Treatments",
          "group": "Non-invasive treatments"
        },
        { "value": "microneedling", "label": "Microneedling", "group": "Invasive treatments" },
        { "value": "endo_lift", "label": "Endo-Lift", "group": "Invasive treatments" },
        {
          "value": "collagen_stimulating",
          "label": "Collagen-Stimulating Procedures",
          "group": "Invasive treatments"
        },
        {
          "value": "microblading",
          "label": "Microblading",
          "group": "Semi-permanent enhancements"
        },
        { "value": "lip_blush", "label": "Lip Blush", "group": "Semi-permanent enhancements" },
        {
          "value": "tattoo_based",
          "label": "Tattoo-Based Treatments",
          "group": "Semi-permanent enhancements"
        }
      ]
    },
    {
      "id": "q8",
      "order": 8,
      "text": "Do you have any medical conditions (e.g. autoimmune disorders, diabetes)?",
      "type": "yesno",
      "required": true,
      "medical": true
    },
    {
      "id": "q9",
      "order": 9,
      "text": "Are you taking any medications (prescription or over-the-counter)?",
      "type": "yesno",
      "required": true,
      "medical": true,
      "followUp": {
        "showWhen": true,
        "type": "text",
        "label": "Please list your medications",
        "maxLength": 2000
      },
      "note": "[Open — client] Follow-up shape not confirmed ([QS] §5)."
    },
    {
      "id": "q10",
      "order": 10,
      "text": "Have you used retinoids (e.g. Isotretinoin / Accutane) in the past 6–12 months?",
      "type": "yesno",
      "required": true,
      "medical": true
    },
    {
      "id": "q11",
      "order": 11,
      "text": "Do you have any allergies (especially to skincare ingredients, lidocaine, latex, dyes)?",
      "type": "yesno",
      "required": true,
      "medical": true,
      "followUp": {
        "showWhen": true,
        "type": "text",
        "label": "Please list your allergies",
        "maxLength": 2000
      },
      "note": "[Open — client] Follow-up shape not confirmed ([QS] §5)."
    },
    {
      "id": "q12",
      "order": 12,
      "text": "Any active infections, cold sores, or skin conditions (e.g. Rosacea, Eczema, Psoriasis)?",
      "type": "yesno",
      "required": true,
      "medical": true
    },
    {
      "id": "q13",
      "order": 13,
      "text": "Are you prone to hyperpigmentation?",
      "type": "yesno",
      "required": true
    },
    {
      "id": "q14",
      "order": 14,
      "text": "What feature do you like the most about your face?",
      "type": "text",
      "required": true,
      "placeholder": "e.g. My eye color",
      "maxLength": 500
    },
    {
      "id": "q15",
      "order": 15,
      "text": "What feature do you dislike the most about your face?",
      "type": "text",
      "required": true,
      "placeholder": "e.g. Eyebrows",
      "maxLength": 500
    },
    {
      "id": "q16",
      "order": 16,
      "text": "Are there any celebrities' facial aesthetics that you'd like to look like?",
      "type": "text",
      "required": true,
      "placeholder": "e.g. Chris Brown",
      "maxLength": 500
    },
    {
      "id": "q17",
      "order": 17,
      "text": "Are you comfortable with weight loss recommendations?",
      "type": "yesno",
      "required": true
    },
    {
      "id": "q18",
      "order": 18,
      "text": "What is your goal?",
      "type": "single",
      "required": true,
      "options": [
        { "value": "refine", "label": "Refine and enhance my facial aesthetic" },
        { "value": "transform", "label": "Significantly transform my facial aesthetic" },
        { "value": "undecided", "label": "Undecided" }
      ]
    },
    {
      "id": "q19",
      "order": 19,
      "text": "Can you grow a full beard?",
      "type": "yesno",
      "required": true,
      "showIf": { "questionId": "q4", "anyOf": ["masculine", "no_preference"] },
      "note": "[Open — client] Branch condition inferred from one recorded pass ([QS] §3, §5)."
    },
    {
      "id": "q20",
      "order": 20,
      "text": "How much distress does your current facial aesthetic cause you?",
      "type": "single",
      "required": true,
      "options": [
        { "value": "none", "label": "No distress at all" },
        { "value": "minor", "label": "Minor distress" },
        { "value": "moderate", "label": "Moderate distress" },
        { "value": "extreme", "label": "Extreme distress and affects my day to day" }
      ]
    },
    {
      "id": "q21",
      "order": 21,
      "text": "How often do you think about your appearance?",
      "type": "single",
      "required": true,
      "options": [
        { "value": "rarely", "label": "Rarely (a few times a week or less)" },
        { "value": "occasionally", "label": "Occasionally (once a day)" },
        { "value": "frequently", "label": "Frequently (multiple times a day)" },
        { "value": "very_often", "label": "Very often (most of the day)" },
        { "value": "constantly", "label": "Constantly (it's always on my mind)" }
      ]
    },
    {
      "id": "q22",
      "order": 22,
      "text": "What motivated you to sign up for FaceIQ?",
      "type": "text",
      "required": true,
      "placeholder": "e.g. Just curious",
      "maxLength": 500
    },
    {
      "id": "q23",
      "order": 23,
      "text": "Anything else you think we should know?",
      "type": "text",
      "required": false,
      "maxLength": 2000
    }
  ]
}
