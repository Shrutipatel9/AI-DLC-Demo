# Backend configuration for LOCAL DEVELOPMENT.
# Copy to `.env` (git-ignored) and replace every <placeholder>.
# Never commit real values. See backend/README.md for every key.

APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL from docker-compose.yml (user/password must match the Compose values)
DATABASE_URL=postgresql+psycopg://app:<db-password>@127.0.0.1:5432/app
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=5
DB_POOL_RECYCLE=1800

# The Next.js origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:3000
# Origins allowed by the CSRF check on /auth/refresh and /auth/logout and by CORS
# (comma-separated). Empty = the value of FRONTEND_ORIGIN.
CSRF_ALLOWED_ORIGINS=
# Comma-separated proxy addresses whose X-Forwarded-For is trusted (empty = none)
TRUSTED_PROXIES=

# Access tokens: JSON map of kid -> base64 key (each >= 32 random bytes).
# Generate a key with:  openssl rand -base64 48
JWT_SIGNING_KEYS={"dev-1":"<base64-key-from-openssl-rand-base64-48>"}
JWT_ACTIVE_KID=dev-1
ACCESS_TOKEN_TTL_SECONDS=900

# One-time codes: base64 key (>= 32 random bytes). Generate with: openssl rand -base64 48
CODE_HMAC_KEY=<base64-key-from-openssl-rand-base64-48>
CODE_TTL_SECONDS=600
CODE_RESEND_COOLDOWN_SECONDS=60
CODE_MAX_FAILURES=5
CODE_LOCK_SECONDS=900

# Refresh sessions and cookie (Secure=false is allowed only for APP_ENV=development or test)
# REFRESH_COOKIE_PATH must be /auth. SAMESITE is lax, strict or none; none requires Secure.
REFRESH_TOKEN_DAYS=7
REFRESH_ATTEMPT_RECOVERY_SECONDS=60
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/auth
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=false

# Password reset token lifetime (minutes)
RESET_TOKEN_MINUTES=10
# Keyed hash for anti-enumeration shadow counters: base64, >= 32 random bytes.
# The placeholder below is refused at start-up. Generate with: openssl rand -base64 48
EMAIL_HASH_KEY=change-me

# Argon2id (OWASP minimum)
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Email: `smtp` sends to Mailpit locally; `fake` only for development/test.
EMAIL_BACKEND=smtp
EMAIL_FROM=no-reply@localhost
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
EMAIL_TIMEOUT_SECONDS=10
EMAIL_SEND_BUDGET_SECONDS=25
EMAIL_MAX_ATTEMPTS=3
EMAIL_MAX_CONCURRENCY=10
AUTH_EMAIL_HOURLY_CAP=500

# Per-IP throttling on the auth endpoints (register, login, verify, resend-code,
# password/*, change-password) and a separate, higher limit for refresh and logout
RATE_LIMIT_BACKEND=postgres
AUTH_RATE_LIMIT_PER_MINUTE=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
REFRESH_RATE_LIMIT_PER_MINUTE=60

# Prometheus metrics (off by default)
METRICS_ENABLED=false
METRICS_ALLOW_CIDRS=127.0.0.1/32

# Onboarding (U3). Empty = the bundled seed files in app/onboarding/data/.
# A changed consent text or questionnaire must use a new "version" inside its file.
ONBOARDING_CONSENT_FILE=
ONBOARDING_QUESTIONNAIRE_FILE=
# Optional https:// professional-support link shown when the disclaimer can't be confirmed.
ONBOARDING_SUPPORT_URL=

# Media storage (U4). Files are private: never served as static files, only through the
# owner-checked GET /media/{fileId}. `local` is the only backend today.
MEDIA_BACKEND=local
MEDIA_ROOT=var/media

# Face landmarks (U4). Fetch the pinned model once: uv run python -m tools.fetch_face_model
FACE_MODEL_PATH=var/models/face_landmarker.task
FACE_MODEL_PRELOAD=true
# Development/test only: landmark overrides for E2E fixture images. Leave empty.
FACE_LANDMARK_OVERRIDES_FILE=

# Photos (U4). PHOTO_ANGLES picks catalog angles, in order (ASM-005).
PHOTO_ANGLES=front,left_3q,right_3q
# Empty = the bundled app/photos/data/catalog_v1.json (rules, guidance, angles).
PHOTO_CATALOG_FILE=
# Optional JSON override of the catalog's pose ranges, in degrees, e.g.
# {"front":[-12,12],"left_3q":[-60,-15],"right_3q":[15,60]}. Empty = catalog values.
PHOTO_POSE_YAW_RANGES=
PHOTO_MAX_UPLOAD_BYTES=10485760
PHOTO_MAX_DIMENSION=2048
# Per-photo thresholds: initial values set during development (ASM-002, US5.9).
PHOTO_MIN_WIDTH=480
PHOTO_MIN_HEIGHT=480
PHOTO_MIN_BRIGHTNESS=60
PHOTO_MAX_BRIGHTNESS=230
PHOTO_MIN_FACE_FRACTION=0.05
PHOTO_MAX_FACE_FRACTION=0.8
PHOTO_OCCLUSION_DARK_RATIO=0.35
PHOTO_OCCLUSION_MIN_CONTRAST=0.06
# Same-person threshold: pairs with a signature distance <= this match (ASM-010).
IDENTITY_THRESHOLD=0.6

# Payments (U5; FR-016). The report price is still open (OQ-002): set it here, never in code.
# REPORT_PRICE_AMOUNT is in minor units (cents): 2900 means 29.00. Both are required.
REPORT_PRICE_AMOUNT=<price-in-minor-units>
REPORT_PRICE_CURRENCY=<ISO-4217-code-such-as-USD>
# `fake` (development/test only) shows a local test checkout page and needs no Stripe keys.
# `stripe` uses Stripe hosted Checkout and needs both keys below (test-mode keys locally);
# forward webhooks with the Stripe CLI (see backend/README.md).
PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TIMEOUT_SECONDS=10
STRIPE_MAX_NETWORK_RETRIES=1
# Where Stripe sends the user back. Empty = FRONTEND_ORIGIN + /payment/success and /payment/cancel.
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=
# Seconds before the confirming screen says the payment is still being confirmed.
PAYMENT_CONFIRM_WAIT_SECONDS=30
# Fake provider only: this API's public URL and the delay before it posts the signed webhook.
FAKE_PAYMENT_BASE_URL=http://localhost:8000
FAKE_PAYMENT_WEBHOOK_DELAY_SECONDS=2
